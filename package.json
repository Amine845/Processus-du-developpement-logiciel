{
  "name": "gestion-recette",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "server": "node scripts/start-server.mjs --dev",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "db:validate": "node scripts/prisma.mjs validate",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "db:seed": "node scripts/prisma.mjs db seed",
    "test:db": "npm run db:generate && node tests/integration/database-check.mjs",
    "build:server": "npm run db:generate && tsc -p tsconfig.server.json",
    "start:server": "npm run build:server && node scripts/start-server.mjs",
    "test:repository": "npm run build:server && node --test tests/integration/recipe-repository-check.mjs",
    "seed:run": "npm run build:server && node scripts/seed.mjs",
    "db:init": "npm run db:migrate && npm run db:seed",
    "test:seed": "npm run build:server && node --test tests/integration/seed-check.mjs",
    "ciqual:import": "node scripts/ciqual.mjs",
    "test:ciqual": "npm run db:generate && node --test tests/integration/ciqual-check.mjs",
    "ciqual:sync": "node scripts/ciqual-sync.mjs",
    "ciqual:watch": "node scripts/ciqual-sync.mjs --watch",
    "ciqual:status": "node scripts/ciqual-sync.mjs --status",
    "test:ciqual:sync": "npm run db:generate && node --test tests/integration/ciqual-sync-check.mjs",
    "test:ciqual:api": "npm run build:server && node --test tests/integration/ciqual-api-check.mjs",
    "equipment:sync": "npm run build:server && node scripts/equipment-sync.mjs",
    "test:equipment": "npm run build:server && node --test tests/integration/recipe-equipment-check.mjs",
    "recipe-tags:sync": "npm run build:server && node scripts/recipe-tags-sync.mjs",
    "test:recipe-tags": "npm run build:server && node --test tests/integration/recipe-tags-check.mjs",
    "tags:sync": "npm run build:server && node scripts/tags-sync.mjs",
    "test:tags": "npm run build:server && node --test tests/integration/ingredient-tags-check.mjs"
  },
  "prisma": {
    "seed": "npm run seed:run"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "45.2.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prisma": "6.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.11"
  }
}
