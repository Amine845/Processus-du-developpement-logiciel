generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recipe {
  id          Int                @id @default(autoincrement())
  title       String             @unique
  description String?
  servings    Int
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  tags        RecipeTagLink[]
  equipment   RecipeEquipment[]
}

model Ingredient {
  id            Int                @id @default(autoincrement())
  canonicalName String
  identityKey   String?            @unique
  ciqualCode    String?
  ciqualFood    CiqualFood?        @relation(fields: [ciqualCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  recipes       RecipeIngredient[]
  tags          IngredientTag[]
}

// Vocabulaire contrôlé de tags descriptifs d'ingrédients (céréale, légume...).
// Sans lien avec la classification CIQUAL ni avec les allergènes.
// `key` est le libellé normalisé (minuscules, sans accents, mots reliés par « - ») ;
// un tag retiré du vocabulaire est désactivé, jamais supprimé en silence.
model Tag {
  id          Int             @id @default(autoincrement())
  key         String          @unique
  label       String          @unique
  active      Boolean         @default(true)
  ingredients IngredientTag[]
}

// La clé primaire composite interdit les doublons d'association.
// Supprimer un ingrédient retire ses associations ; un tag encore associé ne peut pas être supprimé.
model IngredientTag {
  ingredientId Int
  tagId        Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([ingredientId, tagId])
  @@index([tagId])
  @@index([canonicalName])
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  quantity     Float
  unit         String
  position     Int
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([recipeId, position])
  @@index([ingredientId])
}

model RecipeStep {
  id          Int    @id @default(autoincrement())
  recipeId    Int
  position    Int
  instruction String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([recipeId, position])
}

// Full imports retain a JSON snapshot; old subset audits are preserved.
model CiqualImport {
  id           Int          @id @default(autoincrement())
  importedAt   DateTime     @default(now())
  source       String
  version      String
  downloadedAt String
  sourceSha256 String
  fileSha256   String       @unique
  format       String
  attribution  String
  license      String
  rowsRead     Int
  rowsAccepted Int
  rowsRejected Int
  payload      String?
  foods        CiqualFood[]
}

model CiqualFood {
  category     String           @default("unclassified")
  groupCode    String?
  groupName    String?
  subgroupCode String?
  subgroupName String?
  detailGroupCode String?
  detailGroupName String?
  classificationVersion String?
  classificationRule String?
  applicationTags String       @default("[]")
  active       Boolean          @default(true)
  rawData      String?
  code         String           @id
  name         String
  version      String
  baseQuantity Float            @default(100)
  baseUnit     String           @default("g")
  importId     Int
  import       CiqualImport     @relation(fields: [importId], references: [id], onDelete: Restrict)
  nutrients    CiqualNutrient[]
  ingredients  Ingredient[]

  @@index([name])
}

model CiqualNutrient {
  foodCode String
  key      String
  unit     String
  raw      String
  status   String
  value    Float?
  food     CiqualFood @relation(fields: [foodCode], references: [code], onDelete: Restrict)

  @@id([foodCode, key])
}

model CiqualSyncState {
  id         Int       @id
  checkedAt  DateTime?
  releaseKey String?
  lastError  String?
  classificationVersion String?
}

// Vocabulaire éditorial propre aux recettes, indépendant des tags d'ingrédients.
model RecipeTag {
  id Int @id @default(autoincrement())
  key String @unique
  label String @unique
  active Boolean @default(true)
  recipes RecipeTagLink[]
}

model RecipeTagLink {
  recipeId Int
  tagId Int
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag RecipeTag @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@id([recipeId, tagId])
  @@index([tagId])
}

// Matériel requis ; catalogue indépendant des tags éditoriaux et des ingrédients.
model Equipment {
  id Int @id @default(autoincrement())
  key String @unique
  label String @unique
  active Boolean @default(true)
  recipes RecipeEquipment[]
}
model RecipeEquipment {
  recipeId Int
  equipmentId Int
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@id([recipeId, equipmentId])
  @@index([equipmentId])
}
